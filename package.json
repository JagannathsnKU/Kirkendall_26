{
  "name": "ecou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "web": "vite --host",
    "api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/vercel-output.ts",
    "preview": "vite preview --host",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@vercel/blob": "^2.8.1",
    "lucide-react": "^1.51.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "rolldown": "^1.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}

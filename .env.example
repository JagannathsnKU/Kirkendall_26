# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.5-flash-lite

# Postgres connection string. On Vercel, the Neon integration sets this for you.
# Locally, copy DATABASE_URL from Vercel → Storage → your Neon database → .env.local tab.
DATABASE_URL=

# Emails that get the Admin screen, comma-separated. They sign up like anyone else.
ADMIN_EMAILS=

# Password reset emails, sent through Resend (free key: https://resend.com/api-keys).
# EMAIL_FROM must be on a domain you verified in Resend, e.g. EcoU <no-reply@yourdomain.com>.
# Without these, the local server prints reset links in its terminal instead of emailing them.
RESEND_API_KEY=
EMAIL_FROM=
# The app's public address, used for links in emails. On Vercel it defaults to your production domain.
APP_URL=

# Set to 1 to skip the AI check locally (every photo passes).
VERIFY_MOCK=0

# Set to 0 to turn off anti-cheat while testing (metadata, duplicate,
# daily-limit, rate-limit, and screen/stock-photo checks). Restart both servers.
ANTI_CHEAT=1
